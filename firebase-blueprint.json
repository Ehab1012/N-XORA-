{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profiles and account data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "chat_messages": {
      "title": "AI Chat History",
      "description": "Saved conversation messages with Gemini AI Assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "nexoraUserId": { "type": "string", "description": "Account user ID in Nexora workspace" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "attachments": {
          "type": "array",
          "description": "Lightweight metadata and server URLs for attached pictures and files"
        },
        "executedActions": {
          "type": "array",
          "description": "Summary records of role-scoped AI actions executed on behalf of the user"
        },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "role", "content"]
    }
  }
}
